# ============================================================
# Security Dataset Pipeline — Combined Final Configuration
# ============================================================
# Combines pipeline_final (50 sources) + scraper_deep (17 sources)
# Target: 960,000+ raw docs → 400,000+ clean training examples
#
# VPS setup:
#   Scraping:    RTX 4090 on Vast.ai   (~$0.45/hr)
#   Conversion:  H100 on Vast.ai        (~$1.99/hr, vLLM running Qwen2.5-72B)
#   Dedup:       RTX 4090 on Vast.ai   (~$0.45/hr)
#   Fine-tuning: 2x A100 on RunPod     (~$5.00/hr)
#
# Required:  github_token (free)
# Optional:  nvd_api_key, hybrid_analysis_key, alienvault_key (all free)

api:
  github_token: "YOUR_GITHUB_TOKEN_HERE"
  nvd_api_key: ""
  hybrid_analysis_key: ""
  alienvault_key: ""
  model_base_url: "http://localhost:8000/v1"  # vLLM on H100
  model_api_key: "none"
  model_name: "Qwen/Qwen2.5-72B-Instruct-AWQ"
  # For Ollama on 4090 instead:
  # model_base_url: "http://localhost:11434/v1"
  # model_name: "qwen2.5:32b"

output:
  raw_dir: "./data/raw"
  processed_dir: "./data/processed"
  final_file: "./data/final_dataset.jsonl"
  checkpoint_file: "./data/checkpoint.json"

processing:
  converter:
    max_input_chars: 3000
    max_tokens_output: 1500
    delay_seconds: 0.1
    batch_size: 250
  filter:
    min_output_chars: 100
    max_output_chars: 6000
    min_instruction_chars: 20
    lm_filter_enabled: true
    lm_min_score: 7
    delay_seconds: 0.05
  deduplication:
    enabled: true
    similarity_threshold: 0.88
    model: "all-MiniLM-L6-v2"
    batch_size: 256

# ================================================================
# PIPELINE_FINAL SOURCES (50 sources)
# ================================================================

scrapers:

  ctftime:
    enabled: true
    pages: 500
    delay_seconds: 0.8

  github:
