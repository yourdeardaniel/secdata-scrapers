  stackexchange_dumps:
    enabled: true
    # Downloads happen automatically — no manual steps needed.
    # Files are saved to dump_dir and reused on subsequent runs.
    # Set stackoverflow enabled: true to download the 80GB file.
    dump_dir: "./data/se_dumps"
    extract_dir: "./data/se_extracted"
    min_question_score: 2
    min_answer_score: 1
    sites:
      - name: "reverseengineering.stackexchange.com"
        approx_size_gb: 0.2
        security_filter: false
        enabled: true
      - name: "crypto.stackexchange.com"
        approx_size_gb: 0.3
        security_filter: false
        enabled: true
      - name: "security.stackexchange.com"
        approx_size_gb: 2.0
        security_filter: false
        enabled: true
      - name: "unix.stackexchange.com"
        approx_size_gb: 4.0
        security_filter: true
        enabled: true
      - name: "stackoverflow.com"
        approx_size_gb: 80.0
        security_filter: true
        enabled: false   # set true to download the 80GB file

